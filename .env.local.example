# Apex Enterprise Solutions - environment variable reference.
# Copy this file to .env.local and fill in real values; Vercel Production env
# vars are set in Vercel project Settings -> Environment Variables.
# Anything starting with NEXT_PUBLIC_ is exposed to the browser bundle.

# -- Sanity CMS --
# Get these from sanity.io/manage after creating your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# -- Giscus comments --
# Get these from giscus.app after running the setup wizard.
NEXT_PUBLIC_GISCUS_REPO_ID=your_repo_id_here
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your_category_id_here

# -- Analytics & marketing tags --
# All optional. Each tag is consent-gated by components/cookie-banner.tsx.

# GA4 measurement ID (format: G-XXXXXXXXXX). From analytics.google.com.
NEXT_PUBLIC_GA_ID=

# HubSpot portal ID. From HubSpot Settings -> Account -> Account Defaults.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# LinkedIn Insight partner ID (numeric). From LinkedIn Campaign Manager
# -> Account Assets -> Insight Tag.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Microsoft Clarity project ID. From clarity.microsoft.com -> Settings -> Setup.
NEXT_PUBLIC_CLARITY_ID=

# -- Search engine site verification --
# Set after claiming the property in Search Console / Bing Webmaster.
# The values are the "content" attribute of the verification meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# -- Server-side secrets (never NEXT_PUBLIC_) --
# HubSpot private app token used by /api/contact to upsert leads.
HUBSPOT_ACCESS_TOKEN=
